# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used to create staff accounts. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Anthropic API key for reading invoices (console.anthropic.com)
ANTHROPIC_API_KEY=
# Optional: a different model for invoice reading
# INVOICE_MODEL=claude-opus-5-5
